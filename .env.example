# ==============================================================================
# Environment Configuration for Karen & Steven Wedding Container
# ==============================================================================
# Copy this file to .env and configure your values:
# cp .env.example .env

# Tailscale Auth Key (Required for Tailscale container)
# Create a reusable, ephemeral key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-kXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Extra arguments to pass to tailscale daemon
TS_EXTRA_ARGS=

# Flask Secret Key (Used for session signatures)
SECRET_KEY=karen-steven-wedding-secure-key-2026

# Optional: Host port binding (Default: 5000)
HOST_PORT=5000
